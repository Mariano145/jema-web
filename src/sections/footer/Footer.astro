---
import BrandMark from '../hero/BrandMark.astro';
import Button from '../../components/ui/Button.astro';
import { ctas, buildWhatsAppLink } from '../../config/ctas';

const currentYear = new Date().getFullYear();
---

<footer data-nav-dark class="relative overflow-hidden bg-text text-background pt-16 pb-12 md:pt-24 md:pb-16">
  <!-- Decorative blobs (mirror hero pattern, softened opacity for dark bg) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg class="absolute -top-12 -right-24 h-[28rem] w-[28rem] text-secondary opacity-20 blur-3xl" viewBox="0 0 200 200">
      <rect x="40" y="20" width="120" height="24" fill="currentColor" />
      <rect x="136" y="44" width="24" height="100" fill="currentColor" />
      <rect x="40" y="144" width="120" height="24" fill="currentColor" />
      <circle cx="56" cy="180" r="24" fill="currentColor" />
    </svg>
    <svg class="absolute -bottom-12 -left-24 h-96 w-96 text-secondary opacity-20 blur-3xl" viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="80" fill="currentColor" />
    </svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 md:px-8">
    <!-- CTA strip — gives the footer a conversion purpose and bridges the visual jump from Contacto -->
    <div class="relative z-10 mb-12 border-b border-background/20 pb-12 md:mb-16">
      <h3 class="text-2xl font-bold tracking-tight text-background md:text-3xl">
        ¿Listo para dejar de hacer trabajo repetitivo?
      </h3>
      <p class="mt-3 text-base text-background/75">
        Agendá un diagnóstico gratuito. Sin compromiso.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <Button variant="primary" href={ctas.calendlyUrl}>
          Agendar diagnóstico gratuito →
        </Button>
        <Button variant="secondary" href={buildWhatsAppLink(ctas.whatsappMessages.contacto)}>
          Hablar por WhatsApp
        </Button>
      </div>
    </div>

    <div class="relative z-10 grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- Left: Brand -->
      <div>
        <BrandMark class="w-12 h-12 text-background" />
        <p class="mt-3 text-sm text-background/80">
          JEMA — Sistemas que hacen el trabajo repetitivo por vos
        </p>
      </div>

      <!-- Center: Contact -->
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-background/60">
          Contacto
        </h4>
        <a href={`mailto:${ctas.emailContact}`} class="block text-sm hover:text-accent">
          {ctas.emailContact}
        </a>
        <a href={buildWhatsAppLink()} class="mt-2 block text-sm hover:text-accent">
          Hablar por WhatsApp
        </a>
      </div>

      <!-- Right: Legal -->
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-background/60">
          Legal
        </h4>
        <a href={ctas.legalLinks.privacidad} class="block text-sm hover:text-accent">
          Privacidad
        </a>
        {/* TODO: real legal pages */}
        <a href={ctas.legalLinks.terminos} class="mt-2 block text-sm hover:text-accent">
          Términos
        </a>
        {/* TODO: real legal pages */}
      </div>
    </div>

    <div class="relative z-10 mt-12 border-t border-background/20 pt-6 text-center text-sm text-background/60">
      © {currentYear} JEMA. Todos los derechos reservados.
    </div>
  </div>
</footer>