---
import Button from '../../components/ui/Button.astro';
import { buildWhatsAppLink, ctas } from '../../config/ctas';
---

<section id="top" class="relative overflow-hidden bg-background py-16 md:py-20 lg:py-24 pt-24 md:pt-28 lg:pt-32">
  <!-- Decorative background shapes (brand mark inspired, blurred and faded) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg class="absolute top-1/4 -left-24 h-[28rem] w-[28rem] text-secondary opacity-10 blur-3xl" viewBox="0 0 200 200">
      <rect x="40" y="20" width="120" height="24" fill="currentColor" />
      <rect x="136" y="44" width="24" height="100" fill="currentColor" />
      <rect x="40" y="144" width="120" height="24" fill="currentColor" />
      <circle cx="56" cy="180" r="24" fill="currentColor" />
    </svg>
    <svg class="absolute bottom-0 -right-24 h-96 w-96 text-secondary opacity-10 blur-3xl" viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="80" fill="currentColor" />
    </svg>
  </div>

  <div class="relative mx-auto max-w-4xl px-6 text-center md:px-8">
    <p class="text-sm font-medium uppercase tracking-widest text-secondary">
      Automatización · Presencia Digital · Software a Medida
    </p>

    <h1 class="mt-6 text-5xl font-bold tracking-tight leading-tight text-text md:text-6xl lg:text-7xl">
      Sistemas que hacen <span class="gradient-text">el trabajo repetitivo</span> por vos
    </h1>

    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-text/75 md:text-xl">
      Construimos landings, automatizaciones y software a medida para empresas que quieren escalar sin sumar equipo.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <Button variant="primary" href={ctas.calendlyUrl}>
        Agendar diagnóstico gratuito →
      </Button>
      <Button variant="secondary" href={buildWhatsAppLink()}>
        Hablar por WhatsApp
      </Button>
    </div>

    <p class="mt-6 text-sm text-text/50">
      Argentina · ES / EN
    </p>

    <a
      href="#servicios"
      class="mt-16 inline-flex items-center gap-2 text-sm font-medium text-text/70 transition-colors duration-200 hover:text-secondary"
    >
      Explorar
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>

<style>
  .gradient-text {
    background: linear-gradient(
      90deg,
      var(--color-secondary) 0%,
      color-mix(in srgb, var(--color-secondary) 65%, var(--color-background)) 50%,
      var(--color-secondary) 100%
    );
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    animation: gradient-slide 5s ease-in-out infinite;
  }

  @keyframes gradient-slide {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gradient-text {
      animation: none;
    }
  }
</style>
