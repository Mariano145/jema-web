---
import Button from '../../components/ui/Button.astro';
import { buildWhatsAppLink, ctas } from '../../config/ctas';
---

<section id="top" class="bg-background py-16 md:py-20 lg:py-24 pt-24 md:pt-28 lg:pt-32">
  <div class="mx-auto max-w-4xl px-6 md:px-8">
    <p class="text-sm font-medium uppercase tracking-widest text-secondary">
      Automatización · Presencia Digital · Software a Medida
    </p>

    <h1 class="mt-6 text-5xl font-bold tracking-tight leading-tight text-text md:text-6xl lg:text-7xl">
      Sistemas que hacen <span class="text-secondary">el trabajo repetitivo</span> por vos
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-text/75 md:text-xl">
      Construimos landings, automatizaciones y software a medida para empresas que quieren escalar sin sumar equipo.
    </p>

    <div class="mt-10 flex flex-col gap-3 sm:flex-row">
      <Button variant="primary" href={ctas.calendlyUrl}>
        Agendar diagnóstico gratuito →
      </Button>
      <Button variant="secondary" href={buildWhatsAppLink()}>
        Hablar por WhatsApp
      </Button>
    </div>

    <p class="mt-6 text-sm text-text/50">
      Argentina · ES / EN
    </p>

    <a
      href="#servicios"
      class="mt-16 inline-flex items-center gap-2 text-sm font-medium text-text/70 transition-colors duration-200 hover:text-secondary"
    >
      Explorar
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>
