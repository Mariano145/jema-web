---
import Button from '../../components/ui/Button.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import { ctas, buildWhatsAppLink } from '../../config/ctas';
---

<section id="contacto" class="relative overflow-hidden py-16 md:py-20 lg:py-24">
  <!-- Decorative blob (extends hero's visual language into the last light section before footer) -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <svg class="absolute bottom-0 -left-12 h-64 w-64 text-secondary opacity-15 blur-3xl" viewBox="0 0 200 200">
      <circle cx="100" cy="100" r="80" fill="currentColor" />
    </svg>
  </div>

  <div class="relative mx-auto max-w-7xl px-6 md:px-8">
    <div class="mb-12 max-w-2xl md:mb-16">
      <p class="text-sm font-medium uppercase tracking-widest text-secondary">Contacto</p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-text md:text-4xl lg:text-5xl">
        Listos para arrancar
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-text/75">
        Tres formas de empezar. Elegí la que prefieras.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      <!-- Column 1: Calendly -->
      <div>
        <h3 class="mb-4 text-xl font-bold text-text">Agenda una llamada</h3>
        <iframe
          src={ctas.calendlyUrl}
          width="100%"
          height="600"
          frameborder="0"
          class="rounded-lg"
        ></iframe>
      </div>

      <!-- Column 2: WhatsApp -->
      <div>
        <h3 class="mb-4 text-xl font-bold text-text">Hablar por WhatsApp</h3>
        <p class="mb-6 text-base leading-relaxed text-text/75">
          Respuesta en menos de 1 hora en horario laboral.
        </p>
        <Button variant="primary" href={buildWhatsAppLink(ctas.whatsappMessages.contacto)}>
          Hablar por WhatsApp →
        </Button>
      </div>

      <!-- Column 3: Form -->
      <div>
        <h3 class="mb-4 text-xl font-bold text-text">Envianos un mensaje</h3>
        <ContactForm />
      </div>
    </div>
  </div>
</section>
