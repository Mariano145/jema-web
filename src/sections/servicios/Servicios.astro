---
import Card from '../../components/ui/Card.astro';
import { ctas, buildWhatsAppLink } from '../../config/ctas';
---

<section id="servicios" class="bg-white py-16 md:py-20 lg:py-24">
  <div class="mx-auto max-w-7xl px-6 md:px-8">
    <div class="mb-12 max-w-2xl md:mb-16">
      <p class="text-sm font-medium uppercase tracking-widest text-secondary">Lo que hacemos</p>
      <h2 class="mt-4 text-3xl font-bold tracking-tight text-text md:text-4xl lg:text-5xl">Tres verticales, un partner tecnológico</h2>
      <p class="mt-6 text-lg leading-relaxed text-text/75">Webs y captación, automatizaciones operativas o software a medida. Cada vertical se integra con las demás cuando tu operación lo necesita.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3 lg:gap-8">
      <Card
        title="Presencia Digital"
        description="Webs corporativas, landing pages de alta conversión y e-commerce. Convertimos visitas en clientes con canales que ya probaron funcionar."
        ctaLabel="Solicitar cotización"
        ctaHref={ctas.calendlyUrl}
        whatsappMessage={ctas.whatsappMessages.presenciaDigital}
      />
      <Card
        title="Automatización"
        description="Conectamos WhatsApp e Instagram a un CRM único e implementamos agentes IA 24/7 que filtran leads y automatizan tareas repetitivas."
        ctaLabel="Agendar diagnóstico gratuito"
        ctaHref={ctas.calendlyUrl}
        whatsappMessage={ctas.whatsappMessages.automatizacion}
      />
      <Card
        title="Software a Medida"
        description="Dashboards, portales privados y SaaS. Diseñamos, desarrollamos y desplegamos el software exacto que tu operación necesita."
        ctaLabel="Hablar con un arquitecto"
        ctaHref={buildWhatsAppLink(ctas.whatsappMessages.softwareMedida)}
        whatsappMessage={ctas.whatsappMessages.softwareMedida}
      />
    </div>
  </div>
</section>