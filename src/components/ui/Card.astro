---
import Button from './Button.astro';

interface Props {
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
}

const { title, description, ctaLabel, ctaHref } = Astro.props;
---

<article
  class="flex flex-col gap-6 rounded-2xl border border-text/10 bg-white p-8 shadow-sm transition-shadow duration-200 hover:shadow-md"
>
  <h3 class="text-2xl font-bold text-text">{title}</h3>
  <p class="flex-1 text-base leading-relaxed text-text/75">{description}</p>
  <div class="mt-auto flex flex-col gap-3">
    <Button variant="primary" href={ctaHref}>{ctaLabel}</Button>
  </div>
</article>
