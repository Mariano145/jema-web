---
import Button from './Button.astro';
import { buildWhatsAppLink } from '../../config/ctas';

interface Props {
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
  whatsappMessage?: string;
}

const { title, description, ctaLabel, ctaHref, whatsappMessage } = Astro.props;

const whatsappHref = whatsappMessage ? buildWhatsAppLink(whatsappMessage) : null;
---

<article
  class="flex flex-col gap-6 rounded-2xl border border-text/10 bg-white p-8 shadow-sm transition-shadow duration-200 hover:shadow-md"
>
  <h3 class="text-2xl font-bold text-text">{title}</h3>
  <p class="flex-1 text-base leading-relaxed text-text/75">{description}</p>
  <div class="mt-auto flex flex-col gap-3">
    <Button variant="primary" href={ctaHref}>{ctaLabel}</Button>
    {whatsappHref && (
      <a
        href={whatsappHref}
        class="text-sm font-medium text-secondary transition-colors duration-200 hover:text-primary"
      >
        Hablar por WhatsApp →
      </a>
    )}
  </div>
</article>