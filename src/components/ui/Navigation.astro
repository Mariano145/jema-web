---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<nav
  aria-label="Navegación principal"
  class="fixed top-0 left-0 right-0 z-40 transition-colors duration-300 bg-transparent backdrop-blur-md border-b border-text/10 text-text"
  data-nav
>
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4 md:flex-nowrap md:gap-8 md:px-8">
    <a href="#top" class="text-xl font-bold" data-nav-text>JEMA</a>

    <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm sm:gap-x-6 md:flex-nowrap md:gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-medium text-text/70 transition-colors duration-200 hover:text-text data-[active=true]:text-primary"
            data-nav-link
            data-nav-text
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const nav = document.querySelector('[data-nav]');
  const textEls = document.querySelectorAll('[data-nav-text]');
  const navLinks = document.querySelectorAll('[data-nav-link]');

  if (!nav) {
    // Bail if nav not found
  } else {
    // Detect when the dark section (Footer) is in viewport to invert text color
    const darkSections = Array.from(document.querySelectorAll('[data-nav-dark]'));

    function applyDarkMode(isDark: boolean) {
      if (isDark) {
        nav.classList.remove('text-text', 'border-text/10');
        nav.classList.add('text-white', 'border-white/10');
        textEls.forEach((el) => {
          el.classList.remove('text-text', 'text-text/70');
          el.classList.add('text-white', 'text-white/70');
        });
      } else {
        nav.classList.remove('text-white', 'border-white/10');
        nav.classList.add('text-text', 'border-text/10');
        textEls.forEach((el) => {
          el.classList.remove('text-white', 'text-white/70');
          el.classList.add('text-text', 'text-text/70');
        });
      }
    }

    const darkObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            applyDarkMode(true);
          } else if (!darkSections.some((s) => {
            const rect = (s as HTMLElement).getBoundingClientRect();
            return rect.top < window.innerHeight && rect.bottom > 0;
          })) {
            applyDarkMode(false);
          }
        });
      },
      { threshold: 0.1 }
    );

    darkSections.forEach((s) => darkObserver.observe(s));

    // Active link highlighting
    const sections = Array.from(document.querySelectorAll('section[id]'));
    const linkObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            navLinks.forEach((link) => {
              const href = link.getAttribute('href');
              link.toggleAttribute('data-active', href === `#${id}`);
            });
          }
        });
      },
      { threshold: 0.3 }
    );
    sections.forEach((section) => linkObserver.observe(section));
  }
</script>
