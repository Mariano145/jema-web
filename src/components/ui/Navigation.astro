---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<nav
  aria-label="Navegación principal"
  class="fixed top-0 left-0 right-0 z-40 border-b transition-colors duration-300 bg-background border-text/10"
  data-nav
>
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4 md:flex-nowrap md:gap-8 md:px-8">
    <a href="#top" class="text-xl font-bold text-text" data-nav-text>JEMA</a>

    <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm sm:gap-x-6 md:flex-nowrap md:gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-medium text-text/70 transition-colors duration-200 hover:text-text data-[active=true]:text-primary"
            data-nav-link
            data-nav-text
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  type NavEl = HTMLElement;

  const nav = document.querySelector('[data-nav]') as NavEl | null;
  const textEls = document.querySelectorAll<HTMLElement>('[data-nav-text]');

  // Map of section bg variant -> navbar styles
  const variants = {
    white: { bg: 'bg-white', text: 'text-text', border: 'border-text/10' },
    background: { bg: 'bg-background', text: 'text-text', border: 'border-text/10' },
    text: { bg: 'bg-text', text: 'text-white', border: 'border-white/10' },
  } as const;

  type Variant = keyof typeof variants;
  const variantKeys = Object.keys(variants) as Variant[];

  function applyVariant(variant: Variant) {
    if (!nav) return;
    const v = variants[variant];

    // Strip ALL variant classes from nav and text elements
    variantKeys.forEach((key) => {
      const vk = variants[key];
      nav.classList.remove(vk.bg, vk.border);
    });
    textEls.forEach((el) => {
      variantKeys.forEach((key) => {
        el.classList.remove(variants[key].text);
      });
    });

    // Apply new variant
    nav.classList.add(v.bg, v.border);
    textEls.forEach((el) => el.classList.add(v.text));
  }

  // Section detection with IntersectionObserver
  const sections = Array.from(
    document.querySelectorAll<HTMLElement>('section[data-section-bg], footer[data-section-bg]')
  );
  const navHeight = nav?.offsetHeight ?? 64;

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      // Find the section with highest intersection ratio among currently intersecting
      const visible = entries
        .filter((e) => e.isIntersecting && e.intersectionRatio > 0)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio);

      if (visible[0]) {
        const variant = (visible[0].target as HTMLElement).dataset.sectionBg as Variant;
        if (variant && variant in variants) {
          applyVariant(variant);
        }
      }
    },
    {
      rootMargin: `-${navHeight}px 0px -50% 0px`,
      threshold: [0, 0.1, 0.3, 0.5, 0.7, 1],
    }
  );

  sections.forEach((s) => sectionObserver.observe(s));

  // Active link highlighting
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const linkObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            const href = link.getAttribute('href');
            link.toggleAttribute('data-active', href === `#${id}`);
          });
        }
      });
    },
    { threshold: 0.3 }
  );
  sections.forEach((section) => linkObserver.observe(section));
</script>
