---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<nav
  aria-label="Navegación principal"
  class="fixed top-0 left-0 right-0 z-40 text-text"
  data-nav
  data-nav-theme="cream"
>
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4 md:flex-nowrap md:gap-8 md:px-8">
    <a href="#top" class="text-xl font-bold text-text focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-md">JEMA</a>

    <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm sm:gap-x-6 md:flex-nowrap md:gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-medium text-text transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
            data-nav-link
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  [data-nav] {
    background-color: var(--color-background);
    transition:
      background-color 300ms ease,
      color 300ms ease,
      backdrop-filter 300ms ease;
  }

  [data-nav][data-nav-theme='cream'] {
    background-color: color-mix(in srgb, var(--color-background) 88%, transparent);
    color: var(--color-text);
    border-bottom-color: color-mix(in srgb, var(--color-text) 8%, transparent);
    -webkit-backdrop-filter: saturate(140%);
    backdrop-filter: saturate(140%);
  }

  [data-nav][data-nav-theme='light'] {
    background-color: color-mix(in srgb, var(--color-white) 82%, transparent);
    color: var(--color-text);
    border-bottom-color: color-mix(in srgb, var(--color-text) 10%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
  }

  [data-nav][data-nav-theme='dark'] {
    background-color: color-mix(in srgb, var(--color-text) 90%, transparent);
    color: var(--color-background);
    border-bottom-color: color-mix(in srgb, var(--color-background) 12%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
  }

  [data-nav][data-nav-theme='dark'] a {
    color: var(--color-background);
  }

  [data-nav][data-nav-theme='dark'] [data-nav-link]:hover,
  [data-nav][data-nav-theme='dark'] [data-nav-link][data-active] {
    color: var(--color-accent);
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const navLinks = nav.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

    // ---- Active link highlighting via IntersectionObserver ----
    const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));
    const linkObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            navLinks.forEach((link) => {
              const href = link.getAttribute('href');
              link.toggleAttribute('data-active', href === `#${id}`);
            });
          }
        });
      },
      { threshold: 0.3 }
    );
    sections.forEach((section) => linkObserver.observe(section));

    // ---- Theme adaptation: detect which section sits under the nav ----
    const themeTargets = Array.from(
      document.querySelectorAll<HTMLElement>('section[id], footer[data-nav-dark]')
    );

    const resolveTheme = (target: HTMLElement): 'cream' | 'light' | 'dark' => {
      if (target.matches('[data-nav-dark]')) return 'dark';
      if (target.id === 'top') return 'cream';
      return 'light';
    };

    let rafId = 0;
    const updateTheme = () => {
      rafId = 0;
      const navHeight = nav.offsetHeight;
      let current: HTMLElement | null = null;
      for (const target of themeTargets) {
        if (target.getBoundingClientRect().top <= navHeight) {
          current = target;
        } else {
          break;
        }
      }
      if (current) {
        const theme = resolveTheme(current);
        if (nav.dataset.navTheme !== theme) {
          nav.dataset.navTheme = theme;
        }
      }
    };

    const schedule = () => {
      if (!rafId) rafId = requestAnimationFrame(updateTheme);
    };

    updateTheme();
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
  }
</script>
