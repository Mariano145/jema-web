---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<nav
  aria-label="Navegación principal"
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300"
  data-nav
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-8">
    <a href="#" class="text-xl font-bold text-text">JEMA</a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-8 md:flex">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-text/70 transition-colors duration-200 hover:text-text data-[active=true]:text-primary"
            data-nav-link
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile hamburger -->
    <button
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-text md:hidden"
      aria-label="Abrir menú"
      data-nav-toggle
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</nav>

<!-- Mobile menu dialog -->
<dialog class="fixed inset-0 z-50 m-0 h-full w-full max-w-none max-h-full bg-white p-0 backdrop:bg-black/50 md:hidden" data-mobile-menu>
  <div class="flex flex-col items-center justify-center gap-8 pt-24">
    {links.map((link) => (
      <a
        href={link.href}
        class="text-2xl font-medium text-text"
        data-mobile-link
      >
        {link.label}
      </a>
    ))}
    <button
      type="button"
      class="absolute top-4 right-4 p-2 text-text"
      aria-label="Cerrar menú"
      data-mobile-close
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</dialog>

<script>
  const nav = document.querySelector('[data-nav]');
  const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLDialogElement | null;
  const mobileToggle = document.querySelector('[data-nav-toggle]');
  const mobileClose = document.querySelector('[data-mobile-close]');
  const mobileLinks = document.querySelectorAll('[data-mobile-link]');
  const navLinks = document.querySelectorAll('[data-nav-link]');

  // Solid background after scrolling past hero sentinel
  const sentinel = document.querySelector('[data-hero-sentinel]');
  if (sentinel && nav) {
    const sentinelObserver = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          nav.classList.remove('bg-white/95', 'shadow-sm', 'backdrop-blur-sm');
        } else {
          nav.classList.add('bg-white/95', 'shadow-sm', 'backdrop-blur-sm');
        }
      },
      { threshold: 0 }
    );
    sentinelObserver.observe(sentinel);
  }

  // Active link highlighting via IntersectionObserver
  const sections = document.querySelectorAll('section[id]');
  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            const href = link.getAttribute('href');
            link.toggleAttribute('data-active', href === `#${id}`);
          });
        }
      });
    },
    { threshold: 0.3 }
  );
  sections.forEach((section) => sectionObserver.observe(section));

  // Mobile menu open/close
  mobileToggle?.addEventListener('click', () => mobileMenu?.showModal());
  mobileClose?.addEventListener('click', () => mobileMenu?.close());
  mobileLinks.forEach((link) =>
    link.addEventListener('click', () => mobileMenu?.close())
  );
</script>
