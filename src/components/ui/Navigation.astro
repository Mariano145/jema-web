---
interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links: NavLink[];
}

const { links } = Astro.props;
---

<nav
  aria-label="Navegación principal"
  class="fixed top-0 left-0 right-0 z-40 border-b border-text/10 bg-background/80 backdrop-blur-md transition-colors duration-300 text-text"
  data-nav
>
  <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4 md:flex-nowrap md:gap-8 md:px-8">
    <a href="#top" class="text-xl font-bold text-text" data-nav-text>JEMA</a>

    <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm sm:gap-x-6 md:flex-nowrap md:gap-8">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-medium text-text transition-colors duration-200 hover:text-primary data-[active=true]:text-primary"
            data-nav-link
            data-nav-text
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const navLinks = document.querySelectorAll('[data-nav-link]');

  // Active link highlighting via IntersectionObserver
  const sections = Array.from(document.querySelectorAll('section[id]'));
  const linkObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            const href = link.getAttribute('href');
            link.toggleAttribute('data-active', href === `#${id}`);
          });
        }
      });
    },
    { threshold: 0.3 }
  );
  sections.forEach((section) => linkObserver.observe(section));
</script>
