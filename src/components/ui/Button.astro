---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href: string;
  class?: string;
  type?: string;
}

const { variant = 'primary', href, class: className = '', type } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 font-medium transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background';

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary: 'bg-primary text-white hover:bg-secondary',
  secondary:
    'border border-secondary text-secondary hover:bg-secondary hover:text-white bg-transparent',
  ghost: 'text-text hover:text-primary bg-transparent',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

<a href={href} class={classes} type={type}>
  <slot />
</a>
