---
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
  id?: string;
}

const { variant = 'primary', class: className = '', id } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 font-medium transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-60';

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary: 'bg-primary text-white hover:bg-secondary disabled:hover:bg-primary',
  secondary:
    'border border-secondary text-secondary hover:bg-secondary hover:text-white bg-transparent disabled:hover:bg-transparent disabled:hover:text-secondary',
  ghost:
    'text-text hover:text-primary bg-transparent disabled:hover:text-text',
};

const classes = `${base} ${variants[variant]} ${className}`;
---

<button type="submit" id={id} class={classes} data-submit-btn>
  <slot />
</button>
